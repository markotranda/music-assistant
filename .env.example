# Music Assistant configuration — copy to `.env` (never commit `.env`).
# All values can also be edited later in Settings; env vars act as initial/override values.

# Last.fm API key: popularity rankings, scrobbles, similar artists.
LASTFM_API_KEY=your_lastfm_api_key_here

# MusicBrainz requires a descriptive User-Agent with contact info.
MA_USER_AGENT=MusicAssistant/0.0.0 ( your.email@example.com )

# Base URL the CLI talks to.
MA_API_URL=http://localhost:8787

# Server port.
PORT=8787
